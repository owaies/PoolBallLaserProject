# App Settings
PROJECT_NAME="Pool Ball Identification & Laser Positioning API"
HOST="127.0.0.1"
PORT=8000

# Model Configuration
MODEL_PATH="models/best.pt"
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE="auto"

# Upload Settings
# Maximum upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL="INFO"

# Admin authentication is intentionally unconfigured by default.
# If an admin authentication route is enabled, set strong values in your untracked .env:
# ADMIN_PASSWORD=<at least 12 characters>
# ADMIN_JWT_SECRET=<at least 32 random characters>
