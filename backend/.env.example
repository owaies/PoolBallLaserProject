# App Settings
PROJECT_NAME="Pool Ball Identification & Laser Positioning API"
HOST="127.0.0.1"
PORT=8000

# Model Configuration
MODEL_PATH="models/best.pt"
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE="auto"

# Upload Settings
# Maximum upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL="INFO"

# Optional Roboflow inference integration
# Set your own key in this local file. Never commit backend/.env.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID="snooker-ball-detection-rnhxo/3"
ROBOFLOW_API_URL="https://serverless.roboflow.com"

# Browser access. Use a comma-separated list of exact frontend origins.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
